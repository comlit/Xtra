<?xml version="1.0" encoding="utf-8"?>
<!--
    TV focus indicator for navigation rail items. The rail's own focus state is a faint overlay on the
    active indicator, so the focused tab can't be told apart from the selected one without this outline.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset
            android:insetLeft="2dp"
            android:insetTop="2dp"
            android:insetRight="2dp"
            android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/tv_focus_fill" />
                <stroke
                    android:width="3dp"
                    android:color="?attr/colorPrimary" />
                <corners android:radius="16dp" />
            </shape>
        </inset>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
