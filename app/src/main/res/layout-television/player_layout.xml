<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV variant of player_layout: instead of buttons in all four corners and in the middle, everything is in
    one panel at the bottom: what's playing, the progress bar, and a single row of buttons (play/pause first).
    Ids and view types must stay the same as in layout/player_layout.xml (shared ViewBinding); the containers only
    group the buttons, the code shows and hides the buttons themselves.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0"
    android:visibility="gone"
    tools:alpha="1"
    tools:background="#555"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/tvControlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/tv_player_controls_scrim"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- what's playing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom">

            <LinearLayout
                android:id="@+id/topLeftLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/minimize"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="5dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/baseline_expand_more_black_48"
                    android:visibility="gone"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:id="@+id/infoLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/channel"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:ellipsize="end"
                        android:gravity="center_vertical|start"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="channel"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:visibility="gone"
                        tools:text="title"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/category"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:ellipsize="end"
                        android:gravity="center_vertical|start"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="game"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/streamInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/uptimeLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/uptimeIcon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/baseline_circle_24"
                        android:visibility="gone"
                        app:tint="@color/liveStreamRed"
                        tools:visibility="visible" />

                    <Chronometer
                        android:id="@+id/uptimeTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/viewersLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:id="@+id/viewersIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/baseline_person_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/viewersText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        tools:text="13.3K" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- progress (videos and clips) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColor="@android:color/white"
                tools:text="12:16" />

            <LinearLayout
                android:id="@+id/bottomLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <androidx.media3.ui.DefaultTimeBar
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                tools:text="1:12:16" />

        </LinearLayout>

        <!-- all buttons in one row -->
        <LinearLayout
            android:id="@+id/tvButtonsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/playPause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="4dp"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/baseline_play_arrow_black_48"
                app:tint="@android:color/white" />

            <Button
                android:id="@+id/rewind"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:foreground="@drawable/exo_styled_controls_rewind"
                android:gravity="center|bottom"
                android:insetBottom="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:paddingBottom="18dp"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/white"
                app:tint="@android:color/white"
                tools:text="10" />

            <Button
                android:id="@+id/fastForward"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:foreground="@drawable/exo_styled_controls_fastforward"
                android:gravity="center|bottom"
                android:insetBottom="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:paddingBottom="18dp"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/white"
                app:tint="@android:color/white"
                tools:text="10" />

            <LinearLayout
                android:id="@+id/bottomLeftLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/restart"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_replay_black_24" />

                <ImageButton
                    android:id="@+id/seekLive"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/exo_icon_fastforward" />

                <ImageButton
                    android:id="@+id/vodGames"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_format_list_bulleted_black_24" />

                <ImageButton
                    android:id="@+id/volume"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_volume_up_black_24" />

                <ImageButton
                    android:id="@+id/audioCompressor"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_audio_compressor_off_24dp" />

                <ImageButton
                    android:id="@+id/audioOnly"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_audiotrack_black_24" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomRightLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/subtitles"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/exo_ic_subtitle_off" />

                <ImageButton
                    android:id="@+id/toggleChatInput"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_keyboard_black_24" />

                <ImageButton
                    android:id="@+id/toggleChat"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_speaker_notes_black_24" />

                <ImageButton
                    android:id="@+id/fullscreen"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_fullscreen_black_24" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/topRightLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/download"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/ic_file_download_black_24dp" />

                <ImageButton
                    android:id="@+id/follow"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_favorite_border_black_24" />

                <ImageButton
                    android:id="@+id/sleepTimer"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_alarm_black_24" />

                <ImageButton
                    android:id="@+id/aspectRatio"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_aspect_ratio_black_24" />

                <ImageButton
                    android:id="@+id/speed"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/exo_ic_speed" />

                <ImageButton
                    android:id="@+id/quality"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_settings_black_24" />

                <ImageButton
                    android:id="@+id/menu"
                    style="@style/TvPlayerButton"
                    android:src="@drawable/baseline_more_vert_black_24" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
